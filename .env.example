# ------------------------------------------------------------------------------
# SiteScanner - Environment Variables Configuration
# ------------------------------------------------------------------------------
# Copy this file to .env for local development or enter these variables in your
# Vercel Project Settings -> Environment Variables for production deployment.
# ------------------------------------------------------------------------------

# Node Environment ('production' on Vercel, 'development' locally)
NODE_ENV=production

# MongoDB Atlas Connection URI (Required for scan persistence and history)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/site_scanner?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/site_scanner?retryWrites=true&w=majority

# Allowed Client Origins for CORS (comma-separated).
# When deployed on Vercel under the same domain, same-origin requests are used.
# You can set your Vercel domain here (e.g., https://sitescanner.vercel.app).
CLIENT_ORIGIN=https://sitescanner.vercel.app,http://localhost:5173

# Server Port (used in standalone local development only, ignored in Vercel serverless)
PORT=5000

# ------------------------------------------------------------------------------
# Scanner & Execution Configuration (Tuned for Vercel Hobby Serverless limits)
# ------------------------------------------------------------------------------

# Overall scan timeout in milliseconds (Vercel Hobby max execution is 60s)
SCAN_TIMEOUT_MS=30000

# Chromium page navigation timeout in milliseconds
NAVIGATION_TIMEOUT_MS=18000

# Concurrency & Browser settings
MAX_SCAN_CONCURRENCY=2
BROWSER_SCAN_ENABLED=true
CHECK_LINKS=true
MAX_LINK_CHECKS=5
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=2097152
ALLOWED_SCAN_PORTS=80,443,8080,8443

# Rate limiting
SCAN_RATE_LIMIT_MAX=5
SCAN_RATE_LIMIT_WINDOW_MS=600000

# Optional: Set this only if you want to pin Playwright to a custom local executable
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

